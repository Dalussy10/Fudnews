<%- include("partials/header") %>

    <div class="max-w-7xl mx-auto px-6 py-8">

        <div class="flex justify-between items-center mb-8">

            <div>
                <h1 class="text-3xl font-bold">
                    Articles
                </h1>

                <p class="text-gray-500 mt-1">
                    Manage all published articles.
                </p>
            </div>

            <a href="/compose" class="bg-black text-white px-5 py-3 rounded-lg">
                + New Article
            </a>

        </div>


        <div class="bg-white rounded-xl shadow overflow-hidden">

            <div class="overflow-x-auto">

                <table class="w-full">

                    <thead class="bg-gray-100">

                        <tr>

                            <th class="text-left p-4">
                                Title
                            </th>

                            <th class="text-left p-4">
                                Category
                            </th>

                            <th class="text-left p-4">
                                Views
                            </th>

                            <th class="text-left p-4">
                                Status
                            </th>

                            <th class="text-left p-4">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        <% posts.forEach(post=> { %>

                            <tr class="border-t">

                                <td class="p-4">

                                    <div class="font-semibold">
                                        <%= post.title %>
                                    </div>

                                    <div class="text-sm text-gray-500">
                                        <%= post.author || "Fudnews" %>
                                    </div>

                                </td>


                                <td class="p-4">

                                    <%= post.category_name || "Uncategorized" %>

                                </td>


                                <td class="p-4">

                                    <%= post.views || 0 %>

                                </td>


                                <td class="p-4">

                                    <% if (post.featured) { %>

                                        <span class="text-blue-600 font-semibold">
                                            Featured
                                        </span>

                                        <% } %>

                                            <% if (post.breaking) { %>

                                                <span class="text-red-600 font-semibold ml-2">
                                                    Breaking
                                                </span>

                                                <% } %>

                                                    <% if (!post.featured && !post.breaking) { %>

                                                        <span class="text-gray-400">
                                                            Normal
                                                        </span>

                                                        <% } %>

                                </td>


                                <td class="p-4">

                                    <a href="/edit/<%= post.id %>" class="text-blue-600 mr-4">
                                        Edit
                                    </a>

                                    <a href="/post/<%= post.slug %>" class="text-green-600">
                                        View
                                    </a>

                                </td>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <%- include("partials/footer") %>