<%- include('../partials/header'); -%>

    <div class="container mx-auto p-6">

        <!-- PAGE HEADER -->
        <div class="mb-6">

            <h1 class="text-3xl font-bold text-gray-900">
                Manage Comments
            </h1>

            <p class="text-gray-500 mt-1">
                Review, approve and delete comments from your readers.
            </p>

        </div>


        <!-- COMMENTS TABLE -->

        <% if (comments && comments.length> 0) { %>

            <div class="overflow-x-auto bg-white rounded-xl shadow">

                <table class="w-full border-collapse">

                    <thead>

                        <tr class="border-b bg-gray-50">

                            <th class="text-left p-4">
                                Commenter
                            </th>

                            <th class="text-left p-4">
                                Comment
                            </th>

                            <th class="text-left p-4">
                                Article
                            </th>

                            <th class="text-left p-4">
                                Status
                            </th>

                            <th class="text-left p-4">
                                Date
                            </th>

                            <th class="text-left p-4">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% comments.forEach(comment=> { %>

                            <tr class="border-b hover:bg-gray-50">

                                <!-- COMMENTER -->

                                <td class="p-4 font-medium">

                                    <%= comment.fullname || "Anonymous" %>

                                </td>


                                <!-- COMMENT -->

                                <td class="p-4 max-w-md">

                                    <p class="text-gray-700 break-words">

                                        <%= comment.comment %>

                                    </p>

                                </td>


                                <!-- ARTICLE -->

                                <td class="p-4">

                                    <% if (comment.post_id) { %>

                                        <a href="/post/<%= comment.post_slug %>" class="text-blue-600 hover:underline"
                                            target="_blank">

                                            <%= comment.post_title || "View Article" %>

                                        </a>

                                        <% } else { %>

                                            <span class="text-gray-400">
                                                Article unavailable
                                            </span>

                                            <% } %>

                                </td>


                                <!-- STATUS -->

                                <td class="p-4">

                                    <% if (comment.approved) { %>

                                        <span
                                            class="inline-block bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-medium">

                                            Approved

                                        </span>

                                        <% } else { %>

                                            <span
                                                class="inline-block bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-sm font-medium">

                                                Pending

                                            </span>

                                            <% } %>

                                </td>


                                <!-- DATE -->

                                <td class="p-4 whitespace-nowrap text-sm text-gray-500">

                                    <%= comment.created_at ? new Date(comment.created_at).toDateString() : "" %>

                                </td>


                                <!-- ACTIONS -->

                                <td class="p-4">

                                    <div class="flex flex-col gap-2">


                                        <!-- APPROVE / UNAPPROVE -->

                                        <form action="/admin/comments/<%= comment.id %>/toggle" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                                            <button type="submit" class="px-3 py-2 rounded-lg text-sm text-white
                                            <%= comment.approved
                                                ? 'bg-gray-600 hover:bg-gray-700'
                                                : 'bg-green-600 hover:bg-green-700'
                                            %>">

                                                <%= comment.approved ? "Unapprove" : "Approve" %>

                                            </button>

                                        </form>


                                        <!-- DELETE -->

                                        <form action="/admin/comments/<%= comment.id %>/delete" method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit"
                                                class="px-3 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white text-sm">

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            <% }) %>

                    </tbody>

                </table>

            </div>


            <% } else { %>

                <!-- EMPTY STATE -->

                <div class="bg-white rounded-xl shadow p-10 text-center">

                    <h2 class="text-xl font-semibold text-gray-700">

                        No comments yet

                    </h2>

                    <p class="text-gray-500 mt-2">

                        Comments from your readers will appear here.

                    </p>

                </div>

                <% } %>

    </div>

    <%- include('../partials/footer'); -%>