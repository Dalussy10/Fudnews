<%- include('partials/header') %>

    <div class="min-h-screen bg-gray-50">

        <div class="max-w-7xl mx-auto px-6 py-8">


            <!-- ========================================== -->
            <!-- DASHBOARD HEADER -->
            <!-- ========================================== -->

            <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-6 mb-10">

                <div>

                    <div class="flex items-center gap-3">

                        <h1 class="text-4xl font-bold text-gray-900">
                            Dashboard
                        </h1>

                        <span class="px-3 py-1 text-xs font-bold uppercase rounded-full bg-gray-900 text-white">
                            <%= admin.role %>
                        </span>

                    </div>

                    <p class="text-gray-600 mt-2">

                        Welcome back,

                        <strong class="text-gray-900">

                            <%= admin.fullname || admin.email %>

                        </strong>

                    </p>

                </div>


                <!-- Logout -->

                <a href="/admin/logout" class="text-red-600 hover:text-red-700 font-medium flex items-center gap-2">

                    <span>
                        Logout
                    </span>

                </a>

            </div>



            <!-- ========================================== -->
            <!-- DASHBOARD CARDS -->
            <!-- ========================================== -->

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">


                <!-- MANAGE POSTS -->

                <a href="/admin/posts"
                    class="group bg-white rounded-2xl shadow-sm p-6 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-gray-500 font-medium">
                                CONTENT
                            </p>

                            <p class="text-2xl font-bold text-gray-900 mt-2">
                                Manage Posts
                            </p>

                            <p class="text-sm text-gray-500 mt-2">
                                View and manage articles
                            </p>

                        </div>

                        <div class="text-4xl">
                            📰
                        </div>

                    </div>

                </a>



                <!-- TOTAL POSTS -->

                <div class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-gray-500 font-medium">
                                TOTAL POSTS
                            </p>

                            <p class="text-5xl font-bold text-gray-900 mt-2">
                                <%= totalPosts %>
                            </p>

                            <p class="text-sm text-gray-500 mt-2">
                                Published articles
                            </p>

                        </div>

                        <div class="text-4xl">
                            📊
                        </div>

                    </div>

                </div>



                <!-- TOTAL COMMENTS -->

                <a href="/admin/comments"
                    class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-gray-500 font-medium">
                                TOTAL COMMENTS
                            </p>

                            <p class="text-5xl font-bold text-gray-900 mt-2">
                                <%= commentStats.total_comments %>
                            </p>


                            <p class="text-sm text-gray-500 mt-2">

                                <% if (Number(commentStats.pending_comments)> 0) { %>

                                    <span class="text-yellow-600 font-medium">

                                        <%= commentStats.pending_comments %>
                                            pending review

                                    </span>

                                    <% } else { %>

                                        <span class="text-green-600 font-medium">

                                            All comments reviewed

                                        </span>

                                        <% } %>

                            </p>

                        </div>


                        <div class="text-4xl">
                            💬
                        </div>

                    </div>

                </a>

                <!-- TOTAL USERS -->

                <a href="/admin/users" class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100
           hover:shadow-lg hover:-translate-y-1 transition-all">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-gray-500 font-medium">
                                TOTAL USERS
                            </p>

                            <p class="text-5xl font-bold text-gray-900 mt-2">
                                <%= totalUsers %>
                            </p>

                            <p class="text-sm text-gray-500 mt-2">
                                Registered users
                            </p>

                        </div>

                        <div class="text-4xl">
                            👥
                        </div>

                    </div>

                </a>


                <!-- TOTAL VIEWS -->

                <div class="bg-white rounded-2xl shadow-sm p-6 border border-gray-100">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-gray-500 font-medium">
                                TOTAL VIEWS
                            </p>

                            <p class="text-5xl font-bold text-gray-900 mt-2">
                                <%= totalViews.toLocaleString() %>
                            </p>

                            <p class="text-sm text-gray-500 mt-2">
                                Article views
                            </p>

                        </div>

                        <div class="text-4xl">
                            👁️
                        </div>

                    </div>

                </div>

                <!-- CREATE NEW POST -->

                <a href="/compose"
                    class="group bg-black text-white rounded-2xl shadow-sm p-6 hover:bg-gray-900 hover:shadow-lg hover:-translate-y-1 transition-all">

                    <div class="flex items-center justify-between">

                        <div>

                            <p class="text-sm text-gray-300 font-medium">
                                CREATE
                            </p>

                            <p class="text-2xl font-bold mt-2">
                                New Post
                            </p>

                            <p class="text-sm text-gray-300 mt-2">
                                Write a new article
                            </p>

                        </div>

                        <div class="text-4xl">
                            ✍️
                        </div>

                    </div>

                </a>

            </div>



            <!-- ========================================== -->
            <!-- RECENT ARTICLES -->
            <!-- ========================================== -->

            <div class="mt-10">


                <!-- Section Header -->

                <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">

                    <div>

                        <h2 class="text-2xl font-bold text-gray-800">
                            Recent Articles
                        </h2>

                        <p class="text-gray-500 mt-1">
                            Recently published articles.
                        </p>

                    </div>


                    <a href="/compose" class="bg-black text-white px-5 py-2 rounded-lg hover:bg-gray-800 transition">

                        + New Article

                    </a>

                </div>



                <% if (recentPosts && recentPosts.length> 0) { %>


                    <div class="space-y-4">


                        <% recentPosts.forEach(post=> { %>


                            <div
                                class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm hover:shadow-md transition">

                                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">


                                    <!-- ARTICLE INFORMATION -->

                                    <div class="flex-1 min-w-0">


                                        <h3 class="text-lg font-bold text-gray-800">

                                            <%= post.title %>

                                        </h3>


                                        <p class="text-sm text-gray-500 mt-1">

                                            <%= post.category_name || "Uncategorized" %>

                                                <span class="mx-1">
                                                    •
                                                </span>

                                                <%= post.created_at ? new Date(post.created_at).toDateString() : "" %>

                                        </p>



                                        <!-- STATUS -->

                                        <div class="flex flex-wrap gap-2 mt-3">


                                            <% if (post.featured) { %>

                                                <span
                                                    class="px-3 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">

                                                    ★ Featured

                                                </span>

                                                <% } %>



                                                    <% if (post.breaking) { %>

                                                        <span
                                                            class="px-3 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-700">

                                                            ⚡ Breaking

                                                        </span>

                                                        <% } %>



                                                            <% if (!post.featured && !post.breaking) { %>

                                                                <span class="text-xs text-gray-400">

                                                                    No special status

                                                                </span>

                                                                <% } %>


                                        </div>


                                    </div>



                                    <!-- Controls -->
                                    <div class="flex flex-wrap gap-2">

                                        <!-- Featured -->
                                        <form action="/admin/posts/<%= post.id %>/featured" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="<%= post.featured
                ? 'bg-yellow-500 text-white'
                : 'bg-gray-200 text-gray-700' %>
                px-4 py-2 rounded-lg text-sm font-semibold hover:opacity-90">
                                                <%= post.featured ? "★ Remove Featured" : "☆ Make Featured" %>
                                            </button>
                                        </form>


                                        <!-- Breaking -->
                                        <form action="/admin/posts/<%= post.id %>/breaking" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="<%= post.breaking
                ? 'bg-red-600 text-white'
                : 'bg-gray-200 text-gray-700' %>
                px-4 py-2 rounded-lg text-sm font-semibold hover:opacity-90">
                                                <%= post.breaking ? "⚡ Remove Breaking" : "⚡ Make Breaking" %>
                                            </button>
                                        </form>


                                        <!-- Edit -->
                                        <a href="/admin/posts/<%= post.id %>/edit"
                                            class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-semibold hover:bg-blue-700">
                                            Edit
                                        </a>

                                        <!-- Delete -->
                                        <form action="/admin/posts/<%= post.id %>/delete" method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this article?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit"
                                                class="px-4 py-2 rounded-lg bg-red-600 text-white text-sm font-semibold hover:bg-red-700">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>


                            <% }) %>


                    </div>


                    <% } else { %>


                        <!-- NO ARTICLES -->

                        <div class="bg-white rounded-xl border border-gray-100 p-10 text-center">

                            <div class="text-5xl mb-4">
                                📰
                            </div>

                            <p class="text-gray-500">
                                No articles have been published yet.
                            </p>

                            <a href="/compose"
                                class="inline-block mt-4 bg-black text-white px-5 py-2 rounded-lg hover:bg-gray-800">

                                Create Your First Article

                            </a>

                        </div>


                        <% } %>


            </div>



            <!-- ========================================== -->
            <!-- RECENT COMMENTS -->
            <!-- ========================================== -->

            <div class="mt-12">


                <!-- Section Header -->

                <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">


                    <div>

                        <h2 class="text-2xl font-bold text-gray-800">
                            Recent Comments
                        </h2>

                        <p class="text-gray-500 mt-1">
                            Review the latest comments from your readers.
                        </p>

                    </div>


                    <a href="/admin/comments"
                        class="border border-gray-300 bg-white px-5 py-2 rounded-lg hover:bg-gray-100 transition">

                        Manage Comments

                    </a>


                </div>



                <% if (recentComments && recentComments.length> 0) { %>


                    <div class="space-y-4">


                        <% recentComments.forEach(comment=> { %>


                            <div class="bg-white border border-gray-100 rounded-xl p-5 shadow-sm">

                                <div class="flex flex-col lg:flex-row lg:justify-between gap-5">


                                    <!-- COMMENT INFORMATION -->

                                    <div class="flex-1">


                                        <div class="flex flex-wrap items-center gap-3">


                                            <h3 class="font-bold text-gray-800">

                                                <%= comment.fullname || "Anonymous" %>

                                            </h3>



                                            <% if (comment.approved) { %>

                                                <span
                                                    class="px-2 py-1 text-xs font-semibold rounded-full bg-green-100 text-green-700">

                                                    Approved

                                                </span>

                                                <% } else { %>

                                                    <span
                                                        class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-700">

                                                        Pending

                                                    </span>

                                                    <% } %>


                                        </div>



                                        <p class="text-gray-700 mt-2 leading-7">

                                            <%= comment.comment %>

                                        </p>



                                        <p class="text-sm text-gray-500 mt-2">


                                            On:


                                            <a href="/post/<%= comment.post_slug %>"
                                                class="text-blue-600 hover:underline">

                                                <%= comment.post_title || "Unknown Article" %>

                                            </a>


                                            <span class="mx-1">
                                                •
                                            </span>


                                            <%= comment.created_at ? new Date(comment.created_at).toDateString() : "" %>


                                        </p>


                                    </div>



                                    <!-- COMMENT ACTIONS -->

                                    <div class="flex flex-wrap gap-2">


                                        <!-- APPROVE / UNAPPROVE -->

                                        <form action="/admin/comments/<%= comment.id %>/toggle" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="px-4 py-2 rounded-lg text-sm font-medium
                                            <%= comment.approved
                                                ? 'bg-yellow-100 text-yellow-700 hover:bg-yellow-200'
                                                : 'bg-green-600 text-white hover:bg-green-700'
                                            %>">

                                                <%= comment.approved ? "Unapprove" : "Approve" %>

                                            </button>

                                        </form>



                                        <!-- DELETE -->

                                        <form action="/admin/comments/<%= comment.id %>/delete" method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit"
                                                class="px-4 py-2 bg-red-600 text-white hover:bg-red-700 rounded-lg text-sm font-medium">

                                                Delete

                                            </button>

                                        </form>


                                    </div>


                                </div>

                            </div>


                            <% }) %>


                    </div>


                    <% } else { %>


                        <!-- NO COMMENTS -->

                        <div class="bg-white rounded-xl border border-gray-100 p-10 text-center">

                            <div class="text-5xl mb-4">
                                💬
                            </div>

                            <p class="text-gray-500">
                                No comments yet.
                            </p>

                        </div>


                        <% } %>


            </div>

            <!-- ========================================== -->
            <!-- RECENT USERS -->
            <!-- ========================================== -->

            <div class="mt-12">

                <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">

                    <div>

                        <h2 class="text-2xl font-bold text-gray-800">
                            Recent Users
                        </h2>

                        <p class="text-gray-500 mt-1">
                            Recently registered users.
                        </p>

                    </div>

                    <a href="/admin/users" class="border border-gray-300 bg-white px-5 py-2 rounded-lg
                   hover:bg-gray-100 transition">
                        Manage Users
                    </a>

                </div>


                <% if (recentUsers && recentUsers.length> 0) { %>

                    <div class="bg-white border border-gray-100 rounded-xl shadow-sm overflow-hidden">

                        <div class="overflow-x-auto">

                            <table class="w-full">

                                <thead>

                                    <tr class="border-b bg-gray-50">

                                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                                            Name
                                        </th>

                                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                                            Email
                                        </th>

                                        <th class="text-left p-4 text-sm font-semibold text-gray-600">
                                            Role
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% recentUsers.forEach(user=> { %>

                                        <tr class="border-b last:border-b-0 hover:bg-gray-50">

                                            <td class="p-4">

                                                <div class="font-semibold text-gray-800">
                                                    <%= user.fullname %>
                                                </div>

                                            </td>


                                            <td class="p-4 text-gray-600">

                                                <%= user.email %>

                                            </td>


                                            <td class="p-4">

                                                <% if (user.role==="admin" ) { %>

                                                    <span class="px-3 py-1 text-xs font-semibold
                                                     rounded-full bg-purple-100 text-purple-700">
                                                        Admin
                                                    </span>

                                                    <% } else if (user.role==="editor" ) { %>

                                                        <span class="px-3 py-1 text-xs font-semibold
                                                     rounded-full bg-blue-100 text-blue-700">
                                                            Editor
                                                        </span>

                                                        <% } else { %>

                                                            <span class="px-3 py-1 text-xs font-semibold
                                                     rounded-full bg-green-100 text-green-700">
                                                                Journalist
                                                            </span>

                                                            <% } %>

                                            </td>

                                        </tr>

                                        <% }) %>

                                </tbody>

                            </table>

                        </div>

                    </div>


                    <% } else { %>

                        <div class="bg-white rounded-xl border p-8 text-center">

                            <p class="text-gray-500">
                                No users found.
                            </p>

                        </div>

                        <% } %>

            </div>

        </div>


    </div>


    <%- include('partials/footer') %>