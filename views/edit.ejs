<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Post - FUDNEWS</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f8fafc;
        }

        .editor-container {
            max-width: 900px;
            margin: 40px auto;
        }

        .form-card {
            background: white;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
            padding: 35px;
        }

        .logo-title {
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo-title span {
            color: #2563eb;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 8px;
            display: block;
        }

        .form-input {
            width: 100%;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            padding: 12px 14px;
            outline: none;
            transition: 0.2s;
        }

        .form-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        textarea.form-input {
            min-height: 300px;
            resize: vertical;
        }
    </style>

</head>


<body>

    <!-- LOGO -->
    <div class="flex justify-center items-center py-6">

        <h1 class="logo-title">
            FUD <span>NEWS</span>
        </h1>

    </div>


    <!-- MAIN CONTAINER -->
    <div class="editor-container px-4">

        <div class="form-card">

            <!-- HEADER -->
            <div class="mb-8">

                <h2 class="text-3xl font-bold text-gray-800">
                    Edit Post
                </h2>

                <p class="text-gray-500 mt-2">
                    Update your article information and content.
                </p>

            </div>


            <!-- EDIT FORM -->
            <form action="/admin/posts/<%= post.id %>/edit" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <!-- TITLE -->
                <div class="mb-5">

                    <label class="form-label">
                        Post Title
                    </label>

                    <input type="text" name="title" value="<%= post.title %>" class="form-input"
                        placeholder="Enter post title" required>

                </div>


                <!-- CATEGORY -->
                <div class="mb-5">

                    <label class="form-label">
                        Category
                    </label>

                    <select name="category_id" class="form-input" required>

                        <option value="">
                            Select Category
                        </option>

                        <% categories.forEach(category=> { %>

                            <option value="<%= category.id %>" <%=String(category.id)===String(post.category_id)
                                ? "selected" : "" %>
                                >
                                <%= category.name %>
                            </option>

                            <% }) %>

                    </select>

                </div>


                <!-- CURRENT IMAGE -->
                <% if (post.image) { %>

                    <div class="mb-5">

                        <label class="form-label">
                            Current Image
                        </label>

                        <div class="border rounded-lg p-3 bg-gray-50">

                            <img src="<%= post.image %>" alt="<%= post.title %>"
                                class="w-full max-w-md h-64 object-cover rounded-lg">

                        </div>

                    </div>

                    <% } %>


                        <!-- NEW IMAGE -->
                        <div class="mb-5">

                            <label class="form-label">
                                Change Image
                            </label>

                            <input type="file" name="image" accept="image/*" class="form-input">

                            <p class="text-sm text-gray-500 mt-2">
                                Leave this empty if you want to keep the current image.
                            </p>

                        </div>


                        <!-- AUTHOR -->
                        <div class="mb-5">

                            <label class="form-label">
                                Author
                            </label>

                            <input type="text" name="author" value="<%= post.author || '' %>" class="form-input"
                                placeholder="Enter author name">

                        </div>


                        <!-- POST STATUS -->
                        <div class="mb-6">

                            <label class="form-label mb-3">
                                Post Status
                            </label>

                            <div class="flex flex-col sm:flex-row gap-4">


                                <!-- FEATURED -->
                                <label
                                    class="flex items-center gap-3 border rounded-lg p-4 cursor-pointer hover:bg-gray-50 flex-1">

                                    <input type="checkbox" name="featured" value="true" class="w-5 h-5" <%=post.featured
                                        ? "checked" : "" %>
                                    >
                                    <div>

                                        <p class="font-semibold text-gray-800">
                                            ⭐ Featured Post
                                        </p>

                                        <p class="text-sm text-gray-500">
                                            Show this article as featured.
                                        </p>

                                    </div>

                                </label>


                                <!-- BREAKING -->
                                <label
                                    class="flex items-center gap-3 border rounded-lg p-4 cursor-pointer hover:bg-gray-50 flex-1">

                                    <input type="checkbox" name="breaking" value="true" class="w-5 h-5" <%=post.breaking
                                        ? "checked" : "" %>
                                    >

                                    <div>

                                        <p class="font-semibold text-gray-800">
                                            🚨 Breaking News
                                        </p>

                                        <p class="text-sm text-gray-500">
                                            Mark this article as breaking news.
                                        </p>

                                    </div>

                                </label>

                            </div>

                        </div>


                        <!-- CONTENT -->
                        <div class="mb-6">

                            <label class="form-label">
                                Article Content
                            </label>

                            <textarea name="content" class="form-input" placeholder="Write your article content..."
                                required><%= post.content %></textarea>

                        </div>


                        <!-- BUTTONS -->
                        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t">


                            <!-- UPDATE -->
                            <button type="submit"
                                class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold transition">
                                Update Post
                            </button>


                            <!-- CANCEL -->
                            <a href="/admin/posts"
                                class="bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-3 rounded-lg font-semibold text-center transition">
                                Cancel
                            </a>

                        </div>


            </form>

        </div>

    </div>

</body>

</html>