<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Post - FUDNEWS</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

</head>


<body class="bg-gray-100 min-h-screen">


    <!-- ============================= -->
    <!-- TOP NAVIGATION -->
    <!-- ============================= -->

    <nav class="bg-white border-b border-gray-200">

        <div class="max-w-7xl mx-auto px-6">

            <div class="flex items-center justify-between h-16">

                <!-- Logo -->

                <a href="/" class="text-2xl font-bold tracking-tight text-black">
                    FUDNEWS
                </a>


                <!-- Right side -->

                <div class="flex items-center gap-3">

                    <a href="/admin" class="px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm font-medium">
                        <i class="fa-solid fa-gauge mr-1"></i>
                        Dashboard
                    </a>


                    <a href="/admin/posts"
                        class="px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-sm font-medium">
                        <i class="fa-solid fa-newspaper mr-1"></i>
                        Posts
                    </a>


                    <a href="/admin/logout"
                        class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white text-sm font-medium">
                        <i class="fa-solid fa-right-from-bracket mr-1"></i>
                        Logout
                    </a>

                </div>

            </div>

        </div>

    </nav>



    <!-- ============================= -->
    <!-- MAIN CONTENT -->
    <!-- ============================= -->

    <main class="max-w-5xl mx-auto px-6 py-10">


        <!-- PAGE HEADER -->

        <div class="mb-8">

            <h1 class="text-3xl font-bold text-gray-900">

                Create New Post

            </h1>


            <p class="text-gray-500 mt-2">

                Write and publish a new FUDNEWS article.

            </p>

        </div>



        <!-- ============================= -->
        <!-- FORM -->
        <!-- ============================= -->

        <form action="/compose" method="POST" enctype="multipart/form-data"
            class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 md:p-8">

            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <!-- ============================= -->
            <!-- TITLE -->
            <!-- ============================= -->

            <div class="mb-6">

                <label for="title" class="block text-sm font-semibold text-gray-700 mb-2">
                    Post Title
                </label>


                <input type="text" id="title" name="title" value="<%= old && old.title ? old.title : '' %>"
                    placeholder="Enter the article title" required
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500">

            </div>



            <!-- ============================= -->
            <!-- CATEGORY + AUTHOR -->
            <!-- ============================= -->

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">


                <!-- CATEGORY -->

                <div>

                    <label for="category_id" class="block text-sm font-semibold text-gray-700 mb-2">
                        Category
                    </label>


                    <select id="category_id" name="category_id" required
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">

                        <option value="">
                            Select a category
                        </option>


                        <% if (categories && categories.length> 0) { %>

                            <% categories.forEach(category=> { %>

                                <option value="<%= category.id %>" <%=old &&
                                    String(old.category_id)===String(category.id) ? "selected" : "" %>
                                    >

                                    <%= category.name %>

                                </option>

                                <% }) %>

                                    <% } %>

                    </select>

                </div>



                <!-- AUTHOR -->

                <div>

                    <label for="author" class="block text-sm font-semibold text-gray-700 mb-2">
                        Author
                    </label>


                    <input type="text" id="author" name="author"
                        value="<%= old && old.author ? old.author : (currentUser ? currentUser.fullname : '') %>"
                        placeholder="Author name"
                        class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500">

                </div>

            </div>



            <!-- ============================= -->
            <!-- IMAGE -->
            <!-- ============================= -->

            <div class="mb-6">

                <label for="image" class="block text-sm font-semibold text-gray-700 mb-2">
                    Featured Image
                </label>


                <div
                    class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-blue-400 transition">

                    <i class="fa-solid fa-cloud-arrow-up text-4xl text-gray-400 mb-3"></i>


                    <p class="text-gray-600 mb-2">

                        Upload an image for your article

                    </p>


                    <input type="file" id="image" name="image" accept="image/*"
                        class="block w-full text-sm text-gray-600">


                    <p class="text-xs text-gray-400 mt-2">

                        Recommended: JPG, PNG or WEBP

                    </p>

                </div>

            </div>



            <!-- ============================= -->
            <!-- POST STATUS -->
            <!-- ============================= -->

            <div class="mb-6">

                <h2 class="text-sm font-semibold text-gray-700 mb-3">

                    Post Status

                </h2>


                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">


                    <!-- FEATURED -->

                    <label
                        class="flex items-center gap-3 border border-gray-200 rounded-lg p-4 cursor-pointer hover:bg-gray-50">

                        <input type="checkbox" name="featured" value="true" class="w-5 h-5 text-blue-600 rounded">


                        <div>

                            <p class="font-medium text-gray-800">

                                <i class="fa-solid fa-star text-yellow-500 mr-1"></i>

                                Featured Post

                            </p>


                            <p class="text-xs text-gray-500">

                                Highlight this article on the website.

                            </p>

                        </div>

                    </label>



                    <!-- BREAKING -->

                    <label
                        class="flex items-center gap-3 border border-gray-200 rounded-lg p-4 cursor-pointer hover:bg-gray-50">

                        <input type="checkbox" name="breaking" value="true" class="w-5 h-5 text-red-600 rounded">


                        <div>

                            <p class="font-medium text-gray-800">

                                <i class="fa-solid fa-bolt text-red-500 mr-1"></i>

                                Breaking News

                            </p>


                            <p class="text-xs text-gray-500">

                                Mark this article as breaking news.

                            </p>

                        </div>

                    </label>

                </div>

            </div>



            <!-- ============================= -->
            <!-- CONTENT -->
            <!-- ============================= -->

            <div class="mb-8">

                <label for="content" class="block text-sm font-semibold text-gray-700 mb-2">
                    Article Content
                </label>


                <textarea id="content" name="content" rows="14" required placeholder="Write your article here..."
                    class="w-full border border-gray-300 rounded-lg px-4 py-3 resize-y focus:outline-none focus:ring-2 focus:ring-blue-500"><%= old && old.content ? old.content : '' %></textarea>


                <p class="text-xs text-gray-400 mt-2">

                    Write the complete article content before publishing.

                </p>

            </div>



            <!-- ============================= -->
            <!-- BUTTONS -->
            <!-- ============================= -->

            <div class="flex flex-col sm:flex-row justify-end gap-3 border-t border-gray-200 pt-6">


                <a href="/admin/posts"
                    class="px-6 py-3 rounded-lg border border-gray-300 text-gray-700 text-center hover:bg-gray-100">
                    Cancel
                </a>


                <button type="submit"
                    class="px-6 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-semibold">

                    <i class="fa-solid fa-paper-plane mr-2"></i>

                    Publish Post

                </button>

            </div>


        </form>


    </main>


</body>

</html>