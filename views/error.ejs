<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Error <%= statusCode %> | FUDNEWS</title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="min-h-screen bg-gray-50 flex items-center justify-center px-6">

    <div class="text-center max-w-lg">

        <h1 class="text-4xl font-black text-blue-600">
            FUDNEWS
        </h1>


        <div class="mt-8">

            <h2 class="text-7xl font-black text-gray-900">
                <%= statusCode %>
            </h2>


            <h3 class="text-2xl font-bold text-gray-800 mt-4">
                Something went wrong
            </h3>


            <p class="text-gray-500 mt-3 leading-relaxed">
                <%= message %>
            </p>


            <div class="flex flex-col sm:flex-row gap-3 justify-center mt-8">

                <a
                    href="/"
                    class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition"
                >
                    Back to Home
                </a>


                <button
                    onclick="history.back()"
                    class="px-6 py-3 bg-white hover:bg-gray-100 text-gray-700 font-semibold rounded-xl border border-gray-200 transition"
                >
                    Go Back
                </button>

            </div>

        </div>

    </div>

</body>

</html>